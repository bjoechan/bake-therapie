{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Run API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/backend/BakeTherapie.Api/bin/Debug/net10.0/BakeTherapie.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/BakeTherapie.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5160"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
